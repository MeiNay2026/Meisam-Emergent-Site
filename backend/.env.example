# MongoDB connection string. For MongoDB Atlas (free tier is fine):
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=

# Database name to use on that cluster
DB_NAME=doctormeisam

# Anthropic API key for the symptom-checker feature (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for the symptom checker.
# Check https://docs.claude.com/en/docs/about-claude/models for current model IDs.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Comma-separated list of allowed frontend origins for CORS, e.g.:
# https://doctormeisam.com,https://www.doctormeisam.com
CORS_ORIGINS=*

# Optional: base URL of a WordPress site to pull blog posts from (leave blank to disable)
WORDPRESS_BASE_URL=
